# ============ REQUIRED ============
ANTHROPIC_API_KEY=sk-ant-api...
OPENAI_API_KEY=sk-proj-...
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=
SUPABASE_BUCKET=

# ============ SERVER ============
APP_ENV=local
HOST=0.0.0.0
PORT=8000
DEBUG=false
DATA_DIR=./data
CHROMA_PERSIST_DIR=./data/embeddings
DATABASE_URL=postgresql+asyncpg://proposer:proposer-dev@localhost:5432/proposer

# ============ OPTIONAL ============
# Prediction ablations
# PREDICTION_MODE=hybrid
# RETRIEVAL_STRATEGY=chunk_rag
# RETRIEVAL_STRATEGY=proposition_pagerank
# LLM_PREDICTION_PROVIDER=openai
# LLM_EXTRACTION_PROVIDER=openai

# Multi-domain runtime (SHA-20)
# Keep strict gates false for local development until a signed/fresh
# data/eval_artifacts/domain_gates/{domain_id}.json exists.
# ENABLED_DOMAINS=housing.deposit.v1
# DEFAULT_DOMAIN=housing.deposit.v1
# DOMAIN_ROUTER_ENABLED=false
# DOMAIN_CROSS_RETRIEVAL_ALLOWED=false
# DOMAIN_STRICT_EVAL_GATES=false
# DOMAIN_GATE_ARTIFACT_DIR=data/eval_artifacts/domain_gates
# DOMAIN_BETA_ALLOWLIST_USER_IDS=
# DOMAIN_EMPLOYMENT_BETA_ALLOWLIST_USER_IDS=

# Langfuse (observability)
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=http://localhost:3100

# Neo4j (knowledge graph)
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=password

# Pinecone (if using cloud vector DB)
# PINECONE_API_KEY=...
# PINECONE_ENVIRONMENT=us-east-1-aws
