# Copy to deploy/.env.deploy (gitignored) and fill in. Sourced by scripts/deploy/lightsail_deploy.sh.
# These become the Lightsail container's environment variables at deploy time.

export APP_ENV=production
export DEBUG=false

# OpenAI (LLM + embeddings) — required.
export OPENAI_API_KEY=sk-...

# Supabase Postgres — use the SESSION pooler (port 5432), not the transaction pooler (6543).
# Keep sslmode=require in the string (APIConfig validates it); the engine handles TLS for asyncpg.
export DATABASE_URL="postgresql+asyncpg://postgres.<ref>:<password>@aws-0-eu-west-2.pooler.supabase.com:5432/postgres?sslmode=require"

# Supabase Storage (evidence files).
export SUPABASE_URL=https://<ref>.supabase.co
export SUPABASE_KEY=<service-role-key>

# Domain config — only deposit ships; others stay gated "coming soon".
export ENABLED_DOMAINS=housing.deposit.v1
export DEFAULT_DOMAIN=housing.deposit.v1
export DOMAIN_STRICT_EVAL_GATES=false

# LLM providers (all OpenAI).
export LLM_PREDICTION_PROVIDER=openai
export LLM_MEDIATOR_PROVIDER=openai
export LLM_INTAKE_PROVIDER=openai
export LLM_EXTRACTION_PROVIDER=openai

# Allow the deployed frontend origin(s) (comma-separated). Localhost is allowed by default.
export CORS_ORIGINS="https://<your-frontend-domain>"
